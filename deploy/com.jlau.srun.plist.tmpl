<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jlau.srun</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PY__</string>
        <string>__DIR__/srun_login.py</string>
        <string>daemon</string>
        <string>--log</string>
        <string>/Users/USERNAME/Library/Logs/jlau-srun.log</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/jlau-srun.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/jlau-srun.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
