<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jlau.srun.menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__APP__/Contents/MacOS/jlau-srun-menubar</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/jlau-srun-menubar.out</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/jlau-srun-menubar.err</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
